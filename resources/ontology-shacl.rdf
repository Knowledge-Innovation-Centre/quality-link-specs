  <rdf:Description rdf:about="http://data.quality-link.eu/ontology/v1#LearningOpportunitySpecification">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:label xml:lang="en">Learning Opportunity Specification</rdfs:label>
    <rdfs:comment xml:lang="en">The asbtract specification of an opportunity to acquire a given set of learning outcomes, e.g. the general specification of a course, programme or module offered by an education provider.

This class and its shape are based on the ELM *LearningAchievementSpecificationShape* and *QualificationShape*.

Different from the ELM LOQ profile, the shapes are defined as open. Properties that are not used/interpreted by the QualityLink data aggregator have been omitted to simplify the shapes.</rdfs:comment>
    <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:order>
    <shacl-play:main rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</shacl-play:main>
    <sh:targetClass rdf:resource="http://data.europa.eu/snb/model/ontology/Qualification"/>
    <sh:targetClass rdf:resource="http://data.europa.eu/snb/model/ontology/LearningAchievementSpecification"/>
    <sh:property rdf:nodeID="n08f300e8f4014f06a809766f90ebc60cb61"/>
    <sh:property rdf:nodeID="n08f300e8f4014f06a809766f90ebc60cb62"/>
    <sh:property rdf:nodeID="n08f300e8f4014f06a809766f90ebc60cb63"/>
    <sh:property rdf:nodeID="n08f300e8f4014f06a809766f90ebc60cb64"/>
    <sh:property rdf:nodeID="n08f300e8f4014f06a809766f90ebc60cb65"/>
    <sh:property rdf:nodeID="n08f300e8f4014f06a809766f90ebc60cb66"/>
    <sh:property rdf:nodeID="n08f300e8f4014f06a809766f90ebc60cb67"/>
