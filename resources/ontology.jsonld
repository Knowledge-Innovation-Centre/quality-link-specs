  {
    "@id": "_:n333172adfb2b48b2a219e3c483d3e749b57",
    "http://www.w3.org/ns/shacl#pattern": [
      {
        "@value": "^(?i)(http|https):(//(([^@\\[/?#]*)@)?(\\[[[A-Fa-f0-9]\\:\\.]*[%[\\p{L}\\p{Nl}\\p{Nd}]]*\\]|[^\\[/?#:]*)(:(\\d*(?:\\{[^/]+?\\})?))?)?([^?#]*)(\\?([^#]*))?(#(.*))?"
      }
    ]
  },
  {
    "@id": "_:n333172adfb2b48b2a219e3c483d3e749b58",
    "http://www.w3.org/ns/shacl#pattern": [
      {
        "@value": "^(([^:/?#]+):)?(//([^/?#]*))?([^?#]*)(\\?([^#]*))?(#(.*))?"
      }
    ]
  },
